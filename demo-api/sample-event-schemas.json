        },
        {
          "name": "resolution",
          "unit": "string"
        }
      ],
      "dimensions": [
        "codec",
        "quality_preset"
      ]
    }
  },
  {
    "name": "AI Model Inference",
    "description": "Track AI/ML model predictions",
    "dimensions": {
      "attributes": [
        {
          "name": "inference_time_ms",
          "unit": "milliseconds"
        },
        {
