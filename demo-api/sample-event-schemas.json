        "device_type"
      ]
    }
  },
  {
    "name": "Data Transfer",
    "description": "Track data bandwidth usage",
    "dimensions": {
      "attributes": [
        {
          "name": "bytes_transferred",
          "unit": "bytes"
        },
        {
          "name": "transfer_type",
          "unit": "string"
