[
  {
    "name": "API Request",
    "description": "Track API requests made by customers",
    "dimensions": {
      "attributes": [
        {
          "name": "endpoint",
          "unit": "string"
        },
        {
          "name": "method",
          "unit": "string"
        },
        {
          "name": "response_time_ms",
          "unit": "milliseconds"
        },
        {
          "name": "status_code",
          "unit": "number"
        },
        {
          "name": "request_size_bytes",
          "unit": "bytes"
        },
        {
          "name": "response_size_bytes",
          "unit": "bytes"
        }
      ],
      "dimensions": [
        "region",
        "environment",
        "api_version"
      ]
    }
  },
  {
    "name": "Storage Usage",
    "description": "Track storage consumption over time",
    "dimensions": {
      "attributes": [
        {
          "name": "storage_gb",
          "unit": "gigabytes"
        },
        {
          "name": "file_count",
          "unit": "count"
        },
        {
          "name": "bucket_name",
          "unit": "string"
        }
      ],
      "dimensions": [
        "storage_class",
        "region"
      ]
    }
  },
  {
    "name": "Compute Usage",
    "description": "Track compute/processing time",
    "dimensions": {
      "attributes": [
        {
          "name": "duration_seconds",
          "unit": "seconds"
        },
        {
          "name": "cpu_cores",
          "unit": "count"
        },
        {
          "name": "memory_gb",
          "unit": "gigabytes"
        },
        {
          "name": "instance_type",
          "unit": "string"
        }
      ],
      "dimensions": [
        "region",
        "availability_zone"
      ]
    }
  },
  {
    "name": "Active User",
    "description": "Track unique active users",
    "dimensions": {
      "attributes": [
        {
          "name": "user_id",
          "unit": "string"
        },
        {
          "name": "session_duration_minutes",
          "unit": "minutes"
        },
        {
          "name": "actions_count",
          "unit": "count"
        }
