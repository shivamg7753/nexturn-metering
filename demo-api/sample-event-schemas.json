        {
          "name": "protocol",
          "unit": "string"
        }
      ],
      "dimensions": [
        "direction",
        "region",
        "cdn_enabled"
      ]
    }
  },
  {
    "name": "Database Query",
    "description": "Track database operations",
    "dimensions": {
      "attributes": [
        {
          "name": "query_duration_ms",
          "unit": "milliseconds"
        },
        {
          "name": "rows_affected",
          "unit": "count"
        },
        {
          "name": "query_type",
          "unit": "string"
        },
        {
          "name": "database_name",
          "unit": "string"
        }
      ],
      "dimensions": [
        "database_engine",
        "read_write"
      ]
    }
  },
  {
    "name": "Email Sent",
